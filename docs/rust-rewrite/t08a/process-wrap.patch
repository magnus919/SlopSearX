+/// Query the active process count on this exact owned job handle.
+#[cfg(feature = "tokio1")]
+pub(crate) fn active_processes(job: JobHandle) -> Result<u32> {
+	let mut accounting = JOBOBJECT_BASIC_ACCOUNTING_INFORMATION::default();
+	let bytes = std::mem::size_of_val(&accounting)
+		.try_into()
+		.map_err(Error::other)?;
+	// SAFETY: job is retained by JobPort for this call. The output points to
+	// the correctly sized live accounting structure; no process/PID lookup or
+	// ambient NULL job is used. This reads state and cannot change job limits.
+	unsafe {
+		QueryInformationJobObject(
+			Some(job.0),
+			JobObjectBasicAccountingInformation,
+			(&mut accounting as *mut JOBOBJECT_BASIC_ACCOUNTING_INFORMATION).cast(),
+			bytes,
+			None,
+		)
+	}
+	.map_err(Error::other)?;
+	Ok(accounting.ActiveProcesses)
+}
