+            if length == 1 || (length == 2 && previous_cr) {
+                Poll::Ready(Ok(ChunkedState::End))
+            } else {
+                Poll::Ready(Ok(ChunkedState::SourceTrailer {
+                    line_len: 0,
+                    previous_cr: false,
+                }))
+            }
+        } else {
+            Poll::Ready(Ok(ChunkedState::SourceTrailer {
+                line_len: length,
+                previous_cr: byte == b'\r',
+            }))
