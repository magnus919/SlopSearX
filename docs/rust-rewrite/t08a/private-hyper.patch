+            #[cfg(feature = "server")]
+            keep_alive: true,
+            req_method: &mut observed,
+            title_case_headers: false,
+            #[cfg(feature = "server")]
+            date_header: true,
+        }, &mut output).unwrap();
+        (output, observed)
+    }
+    #[test]
+    fn source_raw_target_actual_encoder_preserves_long_dot_fragment_and_absolute_form() {
+        for target in [format!("/?q={}","%CE%BB".repeat(11000)),"/a/%2e%2e/final".into(),"http://Host:00080/a/%2e%2e/final#literal".into(),"http://Host#fragment-without-slash".into()] {
+            let (output, observed)=encode(Method::GET, Some(&target), Version::HTTP_11);
+            assert_eq!(output,format!("GET {target} HTTP/1.1\r\nhost: Host:00080\r\n\r\n").as_bytes());
+            assert_eq!(observed,Some(Method::GET));
+        }
+    }
+    #[test]
+    fn source_raw_target_default_encoder_path_is_unchanged() {
+        let (output, observed)=encode(Method::GET,None,Version::HTTP_11);
+        assert_eq!(output,b"GET /routing-neutral HTTP/1.1\r\nhost: Host:00080\r\n\r\n");
+        assert_eq!(observed,Some(Method::GET));
+        let (output, _)=encode(Method::GET,None,Version::HTTP_10);
+        assert!(output.starts_with(b"GET /routing-neutral HTTP/1.0\r\n"));
+    }
+    #[test]
+    fn source_raw_target_connect_method_and_upgrade_decoder_remain_authoritative() {
+        let (output, mut observed)=encode(Method::CONNECT,Some("Host:443"),Version::HTTP_11);
+        assert!(output.starts_with(b"CONNECT Host:443 HTTP/1.1\r\n"));
+        assert_eq!(observed,Some(Method::CONNECT));
+        let response=MessageHead::<StatusCode>::default();
+        let (_,upgraded)=Client::decoder(&response,&mut observed).unwrap().unwrap();
+        assert!(upgraded);
+    }
