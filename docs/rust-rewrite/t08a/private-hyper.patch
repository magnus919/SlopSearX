+#[cfg(test)]
+mod source_framing_tests {
+    use super::*;
+    async fn collect(wire: Vec<u8>, source: bool) -> io::Result<(Vec<u8>, bool)> {
+        let mut input = Bytes::from(wire);
+        let mut decoder = Decoder::chunked(None, None).with_source_framing(source);
+        let mut output = Vec::new();
+        let mut trailers = false;
+        while !decoder.is_eof() {
+            let frame = decoder.decode_fut(&mut input).await?;
+            match frame.into_data() {
+                Ok(data) => output.extend_from_slice(&data),
+                Err(_) => trailers = true,
+            }
+            if source {
+                assert!(matches!(
+                    &decoder.kind,
+                    Kind::Chunked {
+                        trailers_buf: None,
+                        ..
+                    }
+                ));
+            }
+        }
+        Ok((output, trailers))
+    }
+    fn body_with_trailers(count: usize, size: usize) -> Vec<u8> {
+        let mut wire = b"2\r\n{}\r\n0\r\n".to_vec();
+        for _ in 0..count {
+            wire.extend_from_slice(b"X: ");
+            wire.extend(std::iter::repeat_n(b'a', size));
+            wire.extend_from_slice(b"\r\n");
+        }
+        wire.extend_from_slice(b"\r\n");
+        wire
+    }
+    #[tokio::test]
+    async fn source_framing_per_connection_opt_in_keeps_default_limits() {
+        let wire = body_with_trailers(101, 100);
+        assert!(collect(wire.clone(), false).await.is_err());
+        assert_eq!(
+            collect(wire.clone(), true).await.unwrap(),
+            (b"{}".to_vec(), false)
+        );
+        assert!(collect(wire, false).await.is_err());
+    }
+    #[tokio::test]
+    async fn source_framing_streams_unbounded_trailer_count_with_exact_line_limit() {
+        for (count, size) in [(1024, 100), (1, 20000), (1, 65531)] {
+            assert_eq!(
+                collect(body_with_trailers(count, size), true)
+                    .await
+                    .unwrap(),
+                (b"{}".to_vec(), false)
+            );
+        }
+        assert!(collect(body_with_trailers(1, 65532), true).await.is_err());
+    }
+    #[tokio::test]
+    async fn source_framing_extensions_are_per_size_line_not_aggregate() {
+        let mut single = b"2;".to_vec();
+        single.extend(std::iter::repeat_n(b'x', 20000));
+        single.extend_from_slice(b"\r\n{}\r\n0\r\n\r\n");
+        assert!(collect(single.clone(), false).await.is_err());
+        assert_eq!(collect(single, true).await.unwrap().0, b"{}");
+        let mut many = Vec::new();
+        for i in 0..200 {
+            many.extend_from_slice(b"1;");
+            many.extend(std::iter::repeat_n(b'x', 100));
+            many.extend_from_slice(b"\r\n");
+            many.push(if i == 0 { b'0' } else { b' ' });
+            many.extend_from_slice(b"\r\n");
+        }
+        many.extend_from_slice(b"0\r\n\r\n");
+        assert!(collect(many.clone(), false).await.is_err());
+        assert_eq!(collect(many, true).await.unwrap().0.len(), 200);
+        for zeros in [65533, 65534] {
+            let mut line = vec![b'0'; zeros];
+            line.extend_from_slice(b"2\r\n{}\r\n0\r\n\r\n");
+            assert_eq!(collect(line, true).await.is_ok(), zeros == 65533);
