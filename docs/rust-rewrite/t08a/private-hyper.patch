+#[cfg(test)]
+mod source_framing_pending_tests {
+    use super::*;
+    struct AlternatingRead {
+        bytes: Bytes,
+        pending_next: bool,
+        pending_count: usize,
+        successful_reads: usize,
+    }
+    impl MemRead for AlternatingRead {
+        fn read_mem(&mut self, cx: &mut Context<'_>, len: usize) -> Poll<io::Result<Bytes>> {
+            if self.pending_next {
+                self.pending_next = false;
+                self.pending_count += 1;
+                cx.waker().wake_by_ref();
+                return Poll::Pending;
+            }
+            self.pending_next = true;
+            self.successful_reads += 1;
+            // A one-byte maximum splits every CR/LF, size, extension and body.
+            let n = len.min(1).min(self.bytes.len());
+            Poll::Ready(Ok(self.bytes.split_to(n)))
+        }
+    }
+    async fn decode(wire: Vec<u8>, should_pass: bool) {
+        let original_len = wire.len();
+        let mut input = AlternatingRead {
+            bytes: Bytes::from(wire),
+            pending_next: true,
+            pending_count: 0,
+            successful_reads: 0,
+        };
+        let mut decoder = Decoder::chunked(None, None).with_source_framing(true);
+        let mut output = Vec::new();
+        let mut failed = false;
+        while !decoder.is_eof() {
+            match decoder.decode_fut(&mut input).await {
+                Ok(frame) => {
+                    output.extend_from_slice(
+                        &frame.into_data().expect("source mode discards trailers"),
+                    );
+                    assert!(matches!(
+                        &decoder.kind,
+                        Kind::Chunked {
+                            trailers_buf: None,
+                            ..
+                        }
+                    ));
+                }
+                Err(error) => {
+                    assert_eq!(error.kind(), io::ErrorKind::InvalidData);
+                    failed = true;
+                    break;
+                }
+            }
+        }
+        assert_eq!(!failed, should_pass);
+        assert!(input.pending_count > 0 && input.successful_reads > 0);
+        if should_pass {
+            assert_eq!(output, b"{}");
+            assert!(input.bytes.is_empty());
+            assert_eq!(input.successful_reads, original_len);
+        }
+    }
+    #[tokio::test]
+    async fn source_framing_pending_and_partial_reads_preserve_line_counters() {
+        // Two size lines are each at the boundary: the second must reset,
+        // while Pending between bytes must never reset either counter early.
+        let mut wire = vec![b'0'; 65533];
+        wire.extend_from_slice(b"1\r\n{\r\n");
+        wire.extend(std::iter::repeat_n(b'0', 65533));
+        wire.extend_from_slice(b"1\r\n}\r\n0\r\nX: ");
+        wire.extend(std::iter::repeat_n(b'a', 65531));
+        wire.extend_from_slice(b"\r\nX: second-line\r\n\r\n");
+        decode(wire, true).await;
+        let mut over_size = vec![b'0'; 65534];
+        over_size.extend_from_slice(b"2\r\n{}\r\n0\r\n\r\n");
+        decode(over_size, false).await;
+        let mut over_trailer = b"2\r\n{}\r\n0\r\nX: ".to_vec();
+        over_trailer.extend(std::iter::repeat_n(b'a', 65532));
+        over_trailer.extend_from_slice(b"\r\n\r\n");
+        decode(over_trailer, false).await;
+    }
+}
