functions = []
for path, names in FUNCTIONS.items():
    data, text, tree = source(path)
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and (names is None or node.name in names):
            functions.append(
                {
                    "path": path,
                    "function": node.name,
                    "start": node.lineno,
                    "end": node.end_lineno,
                    "function_ast_sha256": sha(ast.dump(node, include_attributes=False).encode()),
                    "native_owner": "ssx-infra::research_planning + accepted shared policy/store/runner",
                    "native_symbols": SYMBOLS[node.name],
                }
            )
paths = sorted(
    set(SOURCE_TESTS)
    | set(FUNCTIONS)
    | {
        "slopsearx/research_models.py",
        "slopsearx/research_budget.py",
        "slopsearx/capabilities.py",
        "slopsearx/snapshot.py",
        "tests/test_research_retry_followup.py",
    }
)
sources = []
for p in paths:
    data = (ROOT / p).read_bytes()
    blob = subprocess.check_output(["git", "rev-parse", f"{BASELINE}:{p}"], cwd=ROOT, text=True).strip()
    sources.append({"path": p, "git_blob": blob, "sha256": sha(data)})
manifest = {
    "contract": "slopsearx.rust.w03.parity-map",
    "version": 1,
    "plan_id": "W03",
    "baseline": BASELINE,
    "current_native_baseline": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip(),
    "sources": sources,
    "functions": functions,
    "tests": rows(),
    "claim": (
        "Every original test function, literal parameterization and assertion family is bound individually; "
        "bindings require semantic review and actual native execution, not count equality."
    ),
}
(ROOT / "docs/rust-rewrite/w03/regression-map.json").write_text(json.dumps(manifest, indent=2) + "\n")
print(
    json.dumps(
        {
            "source_functions": len(functions),
            "source_tests": len(manifest["tests"]),
            "assertion_families": sum(len(t["assertion_families"]) for t in manifest["tests"]),
            "sources": len(sources),
        }
    )
)
