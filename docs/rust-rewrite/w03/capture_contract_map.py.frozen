def sha(data):
    return hashlib.sha256(data).hexdigest()


def source(path):
    data = (ROOT / path).read_bytes()
    return data, data.decode(), ast.parse(data)


def literal(node):
    try:
        return ast.literal_eval(node)
    except ValueError:
        if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Mult):
            left, right = literal(node.left), literal(node.right)
            if isinstance(left, (list, tuple)) and type(right) is int:
                return left * right
        # The only computed source fixture is this fixed eleven-element evidence list.
        if isinstance(node, ast.ListComp) and ast.unparse(node) == "[f'a:{i}' for i in range(11)]":
            return [f"a:{i}" for i in range(11)]
        if isinstance(node, ast.List):
            return [literal(v) for v in node.elts]
        if isinstance(node, ast.Tuple):
            return tuple(literal(v) for v in node.elts)
        if isinstance(node, ast.Dict):
            return {literal(k): literal(v) for k, v in zip(node.keys, node.values)}
        raise RuntimeError("nonliteral parameterization requires explicit mapping: " + ast.unparse(node))


def rows():
    rows = []
    for path in SOURCE_TESTS:
        data, text, tree = source(path)
        for node in tree.body:
            if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) or not node.name.startswith("test_"):
                continue
            if node.name not in CASES:
                raise RuntimeError("unmapped original test: " + node.name)
            parameters = []
            for decorator in node.decorator_list:
                if (
                    isinstance(decorator, ast.Call)
                    and isinstance(decorator.func, ast.Attribute)
                    and decorator.func.attr == "parametrize"
                ):
                    parameters.append({"names": literal(decorator.args[0]), "cases": literal(decorator.args[1])})
            assertions = []
            for assertion in ast.walk(node):
                if isinstance(assertion, ast.Assert):
                    assertions.append(
                        {
                            "line": assertion.lineno,
                            "expression": ast.unparse(assertion.test),
                            "ast_sha256": sha(ast.dump(assertion, include_attributes=False).encode()),
                        }
                    )
                elif (
                    isinstance(assertion, ast.Call)
                    and isinstance(assertion.func, ast.Attribute)
                    and assertion.func.attr == "raises"
                ):
                    assertions.append(
                        {
                            "line": assertion.lineno,
                            "expression": ast.unparse(assertion),
                            "ast_sha256": sha(ast.dump(assertion, include_attributes=False).encode()),
                        }
                    )
            rows.append(
                {
                    "path": path,
                    "function": node.name,
                    "start": node.lineno,
                    "end": node.end_lineno,
                    "function_ast_sha256": sha(ast.dump(node, include_attributes=False).encode()),
                    "parameterizations": parameters,
                    "assertion_families": sorted(assertions, key=lambda x: x["line"]),
                    "native_cases": CASES[node.name],
                    "intentional_differences": DIFFERENCES.get(node.name, []),
                }
            )
    return rows


