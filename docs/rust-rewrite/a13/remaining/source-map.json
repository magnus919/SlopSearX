  "original_tests": [
    {
      "engine": "hibp",
      "original_function": "test_search_returns_breaches",
      "source_file": "tests/test_hibp.py",
      "source_excerpt": "    async def test_search_returns_breaches(self, adapter):\n        data = [\n            {\n                \"Name\": \"Adobe\",\n                \"Domain\": \"adobe.com\",\n                \"BreachDate\": \"2013-10-04\",\n                \"PwnCount\": 15238235,\n                \"DataClasses\": [\"Email addresses\", \"Passwords\"],\n                \"Description\": \"In October 2013, Adobe suffered a major breach.\",\n            }\n        ]\n        async with MockHTTP(lambda r: httpx.Response(200, json=data)):\n            result = await adapter.search(\"test@example.com\")\n        assert result.status == EngineStatus.OK\n        assert len(result.results) == 1\n        assert \"Adobe\" in result.results[0].title\n        assert \"Email addresses\" in result.results[0].content\n\n",
      "source_executed": false,
      "native_selector": "hibp_source_success_complete_outbound",
      "status": "PLANNED_SOURCE_DERIVATION_NOT_COMPILED"
    },
    {
      "engine": "hibp",
      "original_function": "test_no_breaches_404",
      "source_file": "tests/test_hibp.py",
      "source_excerpt": "    async def test_no_breaches_404(self, adapter):\n        async with MockHTTP(lambda r: httpx.Response(404)):\n            result = await adapter.search(\"nonexistent@example.com\")\n        assert result.status == EngineStatus.OK\n        assert len(result.results) == 0\n\n",
      "source_executed": false,
      "native_selector": "hibp_404_empty_before_json",
      "status": "PLANNED_SOURCE_DERIVATION_NOT_COMPILED"
    },
    {
      "engine": "hibp",
      "original_function": "test_missing_api_key",
      "source_file": "tests/test_hibp.py",
      "source_excerpt": "    async def test_missing_api_key(self):\n        adapter = self._adapter_no_key()\n        result = await adapter.search(\"test@example.com\")\n        assert result.status == EngineStatus.ERROR\n        assert \"API key\" in (result.error_message or \"\")\n\n",
      "source_executed": false,
      "native_selector": "hibp_missing_key_and_admission_precedence",
      "status": "PLANNED_SOURCE_DERIVATION_NOT_COMPILED"
    },
