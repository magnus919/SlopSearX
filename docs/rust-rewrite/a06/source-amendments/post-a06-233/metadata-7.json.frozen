        "observability::metrics::original_metrics_tests::original_workflow_metric_assertions",
        "observability::metrics::source_replay::actual_source_metric_catalog_and_workflow_render",
        "observability::metrics::tests::all_metric_definitions_have_unique_identity",
        "observability::metrics::tests::closed_workflow_and_event_vocabularies",
        "observability::metrics::tests::empty_success_is_not_error_and_caller_cancelled_is_excluded",
        "observability::metrics::tests::fixed_buckets_counts_and_invalid_values",
        "observability::metrics::tests::traffic_does_not_invent_series",
        "observability::metrics::wire_controls::accumulated_histogram_overflow_uses_prometheus_spelling",
        "observability::metrics::wire_controls::actual_source_numbers_and_escaped_series_order",
        "observability::metrics::workflow_helpers::workflow_transitions_recovery_and_event_reads_close_stale_gauges",
        "observability::sentry::lifecycle_controls::cancelled_then_concurrent_shutdown_retains_handle_until_real_response_and_join",
        "observability::sentry::lifecycle_controls::completion_guard_signals_even_when_its_task_panics",
        "observability::sentry::lifecycle_controls::non_success_and_connection_refusal_are_nonfatal_without_retry",
        "observability::sentry::never_polled_control::never_polled_worker_abort_drops_each_envelope_and_signals_completion",
        "observability::sentry::tests::disabled_and_sample_zero_create_no_sender_http_owner_or_worker",
        "observability::sentry::tests::full_queue_and_hanging_post_shutdown_account_for_discarded_work_and_close_socket",
        "observability::sentry::tests::public_operational_error_posts_exact_envelope_auth_and_native_identity",
