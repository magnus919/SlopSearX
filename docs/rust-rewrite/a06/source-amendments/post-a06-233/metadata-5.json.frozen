  "original_tests": [
    {
      "function": "test_search_returns_entries",
      "nodeid": "tests/test_dehashed.py::TestDeHashedAdapter::test_search_returns_entries",
      "source_executed": false,
      "source_excerpt": "    async def test_search_returns_entries(self, adapter):\n        data = {\n            \"entries\": [\n                {\n                    \"email\": \"test@example.com\",\n                    \"username\": \"testuser\",\n                    \"password\": \"secret123\",\n                    \"hashed_password\": \"hash123\",\n                    \"ip_address\": \"1.2.3.4\",\n                    \"database_name\": \"TestDB\",\n                    \"obtained_from\": \"BreachCorp\",\n                }\n            ]\n        }\n        async with MockHTTP(lambda r: httpx.Response(200, json=data)):\n            result = await adapter.search(\"test@example.com\")\n        assert result.status == EngineStatus.OK\n        assert len(result.results) == 1\n        assert \"test@example.com\" in result.results[0].content\n        assert \"secr\" in result.results[0].content  # truncated password appears\n\n",
      "native_selector": "full_source_success_and_complete_outbound",
      "native_case": "source-success"
    },
    {
      "function": "test_missing_api_key",
      "nodeid": "tests/test_dehashed.py::TestDeHashedAdapter::test_missing_api_key",
      "source_executed": false,
      "source_excerpt": "    async def test_missing_api_key(self):\n        adapter = self._adapter_no_key()\n        result = await adapter.search(\"test@example.com\")\n        assert result.status == EngineStatus.ERROR\n        assert \"API key\" in (result.error_message or \"\")\n\n",
      "native_selector": "missing_key_and_admission_precedence",
      "native_case": "missing-key"
    },
    {
      "function": "test_rate_limited",
      "nodeid": "tests/test_dehashed.py::TestDeHashedAdapter::test_rate_limited",
      "source_executed": false,
      "source_excerpt": "    async def test_rate_limited(self, adapter):\n        async with MockHTTP(lambda r: httpx.Response(429)):\n            result = await adapter.search(\"test@example.com\")\n        assert result.status == EngineStatus.RATE_LIMITED\n\n",
      "native_selector": "http_status_classification_and_redaction",
      "native_case": "status-429"
    },
    {
      "function": "test_adapter_registered",
      "nodeid": "tests/test_dehashed.py::TestDeHashedAdapter::test_adapter_registered",
      "source_executed": false,
      "source_excerpt": "    def test_adapter_registered(self):\n        from slopsearx.adapter import list_engines\n\n        assert \"dehashed\" in list_engines()\n",
      "native_selector": "registry_factory_preserves_all_catalog_metadata",
      "native_case": "real-registration"
    }
  ],
