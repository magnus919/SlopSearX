+impl ConnectorService {
+    // The configured target retains an explicit :0 in Host and proxy absolute-form.
+    // Connection selection uses the scheme default, including a proxy tunnel to HTTPS.
+    fn destination_uri(&self, dst: Uri) -> Uri {
+        if !self.exact_gateway_endpoint || dst.port_u16() != Some(0) {
+            return dst;
+        }
+        let authority = dst.authority().expect("port requires authority");
+        let host = authority.host().parse().expect("URI already contains valid host");
+        let mut parts = dst.into_parts();
+        parts.authority = Some(host);
+        Uri::from_parts(parts).expect("valid URI with the original host")
+    }
+}
