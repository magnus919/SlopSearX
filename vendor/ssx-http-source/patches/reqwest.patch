+    /// Experimental complete HTTP/1 send-event timeout, independent of reads.
+    /// Use an HTTP/1-only client; HTTP/2 and HTTP/3 are not supported by this prototype.
+    #[cfg(feature = "ssx-send-operation-timeout")]
+    pub fn send_operation_timeout(mut self, timeout: Duration) -> RequestBuilder {
+        if let Ok(ref mut req) = self.request {
+            req.extensions_mut()
+                .insert(hyper::ext::SendOperationTimeout(timeout));
+        }
+        self
+    }
+
+    /// Select the experimental HTTP/1 source-profile send and plaintext-read budgets.
+    ///
+    /// Each serialized send event has its own nonrenewed `write` budget. Each
+    /// demanded plaintext IO read has a fresh `read` budget. This disables the
+    /// client's header/frame read timeout for this request only. It does not
+    /// install connect, pool, callback or whole-request timeouts.
+    /// An HTTP/1-only client is required; other requests keep their own policy.
+    #[cfg(feature = "ssx-http1-source-read")]
+    pub fn source_http1_timeouts(mut self, write: Duration, read: Duration) -> RequestBuilder {
+        if let Ok(ref mut req) = self.request {
+            req.extensions_mut()
+                .insert(hyper::ext::SendOperationTimeout(write));
+            req.extensions_mut()
+                .insert(hyper::ext::SourceHttp1ReadTimeout(read));
+        }
+        self
+    }
