+#[cfg(test)]
+mod source_redirect_profile_tests {
+    use super::*;
+    use std::sync::Mutex;
+    #[derive(Default)]
+    struct Recording {
+        policies: Mutex<Vec<OAuthHttpRedirectPolicy>>,
+    }
+    impl OAuthHttpClient for Recording {
+        fn execute(&self, request: OAuthHttpRequest) -> OAuthHttpClientFuture<'_> {
+            Box::pin(async move {
+                self.policies.lock().unwrap().push(request.redirect_policy);
+                let path = request.request.uri().path();
+                let (status, body) = if path == "/register" {
+                    (
+                        200,
+                        br#"{"client_id":"source-client","token_endpoint_auth_method":"none"}"#
+                            .to_vec(),
+                    )
+                } else if path == "/token" {
+                    (200,br#"{"access_token":"source-access","token_type":"bearer","refresh_token":"source-refresh"}"#.to_vec())
+                } else {
+                    (404, vec![])
+                };
+                Ok(oauth2::http::Response::builder()
+                    .status(status)
+                    .body(body)?)
+            })
+        }
+    }
+    #[tokio::test]
+    async fn source_profile_is_explicit_and_reaches_discovery_registration_exchange_refresh() {
+        let http = Arc::new(Recording::default());
+        let mut manager = AuthorizationManager::new_with_oauth_http_client(
+            "http://source.invalid/mcp",
+            http.clone(),
+        )
+        .await
+        .unwrap();
+        assert_eq!(
+            manager.oauth_redirect_policy(OAuthHttpRedirectPolicy::Stop),
+            OAuthHttpRedirectPolicy::Stop
+        );
+        assert_eq!(
+            manager.oauth_redirect_policy(OAuthHttpRedirectPolicy::Follow),
+            OAuthHttpRedirectPolicy::Follow
+        );
+        manager.use_source_within_origin_redirects();
+        manager
+            .discovery_get(&Url::parse("http://source.invalid/metadata").unwrap())
+            .await
+            .unwrap();
+        manager.set_metadata(AuthorizationMetadata {
+            authorization_endpoint: "http://source.invalid/authorize".into(),
+            token_endpoint: "http://source.invalid/token".into(),
+            registration_endpoint: Some("http://source.invalid/register".into()),
+            ..Default::default()
+        });
+        manager
+            .register_client("source", "http://127.0.0.1:8765/callback", &[])
+            .await
+            .unwrap();
+        let url = Url::parse(&manager.get_authorization_url(&[]).await.unwrap()).unwrap();
+        let state = url
+            .query_pairs()
+            .find(|(k, _)| k == "state")
+            .unwrap()
+            .1
+            .into_owned();
+        manager
+            .exchange_code_for_token("source-code", &state)
+            .await
+            .unwrap();
+        manager.refresh_token().await.unwrap();
+        let policies = http.policies.lock().unwrap();
+        assert_eq!(policies.len(), 4);
+        assert!(
+            policies
+                .iter()
+                .all(|p| *p == OAuthHttpRedirectPolicy::SourceWithinOrigin)
+        );
+    }
+}
