# Scoped T02 protocol qualification only. Production packaging belongs to O04.
FROM rust:1.99.0-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends cmake clang libclang-dev pkg-config patch xz-utils && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo .cargo
COPY crates crates
COPY contracts contracts
COPY vendor vendor
COPY docs/rust-rewrite docs/rust-rewrite
ENV CARGO_BUILD_JOBS=2 CARGO_INCREMENTAL=0
RUN cargo build --locked --release -p ssx-http --example t02_fixture --example t02_image_smoke

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libgcc-s1 && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/examples/t02_fixture /usr/local/bin/ssx-t02-http
COPY --from=build /src/target/release/examples/t02_image_smoke /usr/local/bin/ssx-t02-image-smoke
# Both vendor libxml2's Python support and all backend/interpreter fallbacks are absent.
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/ssx-t02-image-smoke"]
